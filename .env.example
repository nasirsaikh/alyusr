DEBUG=1
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
DEFAULT_FROM_EMAIL=noreply@alyusr.local
TIME_ZONE=Asia/Muscat

# sqlite (development) or mssql (production)
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=yes

# Production security
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0

# Uploads
MAX_UPLOAD_MB=20

# Optional task callable allowlist; comma separated module prefixes
TASK_CALLABLE_ALLOWLIST=apps.scheduler.tasks,apps.tickets.tasks
